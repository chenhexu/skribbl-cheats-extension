{
  "manifest_version": 3,
  "name": "Skribbl Auto Guesser",
  "version": "2.3.3",
  "version_name": "2.3.3",
  "description": "Hint-aware word suggestions and an image Auto-Drawer for skribbl.io, with optional AI that runs on your computer.",
  "homepage_url": "https://github.com/chenhexu/skribbl-cheats-extension",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "storage"],
  "optional_permissions": ["offscreen"],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data: blob:;"},
  "optional_host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    { "resources": ["page-hook.js"], "matches": ["https://skribbl.io/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://skribbl.io/*"],
      "js": ["socket-hook.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://skribbl.io/*"],
      "js": ["drawing-engine.js", "drawer-studio.js", "drawer.js", "guess-delivery.js", "word-search.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
